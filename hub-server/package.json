{
  "name": "hub",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate:dev": "bunx --bun prisma migrate dev && bunx --bun prisma generate",
    "prisma:migrate:deploy": "bunx --bun prisma migrate deploy",
    "prisma:migrate:reset": "bunx --bun prisma migrate reset && bunx --bun prisma generate",
    "prisma:studio": "bunx --bun prisma studio",
    "typecheck": "bunx --bun prisma generate && bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "7.8.0",
    "hono": "^4.12.23",
    "nanoid": "^5.1.11",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "prisma": "7.8.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
