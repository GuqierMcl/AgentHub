generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "sqlite"
}

model Conversation {
  id                   String  @id @map("id")
  title                String  @map("title")
  mode                 String  @map("mode")
  status               String  @default("active") @map("status")
  orchestratorAgentId  String? @map("orchestrator_agent_id")
  lastMessageId        String? @map("last_message_id")
  lastMessageAt        String? @map("last_message_at")
  pinnedAt             String? @map("pinned_at")
  archivedAt           String? @map("archived_at")
  metadataJson         String  @default("{}") @map("metadata_json")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  agents       ConversationAgent[]
  messages     Message[]
  pins         MessagePin[]
  runs         Run[]
  artifacts    Artifact[]
  permissions  PermissionRequest[]

  @@index([status, lastMessageAt], map: "idx_conversations_status_last_message_at")
  @@index([pinnedAt], map: "idx_conversations_pinned_at")
  @@map("conversations")
}

model ConversationAgent {
  id             String @id @map("id")
  conversationId String @map("conversation_id")
  agentId        String @map("agent_id")
  joinedAt       String @map("joined_at")
  sortOrder      Int    @default(0) @map("sort_order")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentId], map: "uq_conversation_agents_conv_agent")
  @@index([conversationId], map: "idx_conversation_agents_conversation_id")
  @@map("conversation_agents")
}

model Message {
  id                String  @id @map("id")
  conversationId    String  @map("conversation_id")
  runId             String? @map("run_id")
  runtimeMessageId  String? @map("runtime_message_id")
  runtimeRunId      String? @map("runtime_run_id")
  messageIndex      Int?    @map("message_index")
  surface           String  @default("chat") @map("surface")
  role              String  @map("role")
  senderType        String  @map("sender_type")
  senderId          String? @map("sender_id")
  agentId           String? @map("agent_id")
  taskId            String? @map("task_id")
  groupId           String? @map("group_id")
  parentMessageId   String? @map("parent_message_id")
  regeneratedFromId String? @map("regenerated_from_id")
  status            String  @default("created") @map("status")
  finishReason      String? @map("finish_reason")
  firstEventSequence Int?   @map("first_event_sequence")
  lastEventSequence  Int?   @map("last_event_sequence")
  metadataJson      String  @default("{}") @map("metadata_json")
  uiMessageJson     String? @map("ui_message_json")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")
  completedAt       String? @map("completed_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          Run?         @relation("RunMessages", fields: [runId], references: [id])
  triggerForRun Run[]       @relation("RunTriggerMessage")
  parts        MessagePart[]
  pins         MessagePin[]

  @@index([conversationId, createdAt], map: "idx_messages_conversation_id_created_at")
  @@index([runId], map: "idx_messages_run_id")
  @@index([runId, runtimeMessageId], map: "idx_messages_run_runtime_message_id")
  @@index([conversationId, firstEventSequence], map: "idx_messages_conversation_id_first_event_sequence")
  @@index([runId, firstEventSequence], map: "idx_messages_run_first_event_sequence")
  @@index([surface, firstEventSequence], map: "idx_messages_surface_first_event_sequence")
  @@index([senderId], map: "idx_messages_sender_id")
  @@index([parentMessageId], map: "idx_messages_parent_message_id")
  @@unique([runId, runtimeMessageId], map: "uq_messages_run_runtime_message_id")
  @@map("messages")
}

model MessagePart {
  id             String  @id @map("id")
  messageId      String  @map("message_id")
  conversationId String  @map("conversation_id")
  runId          String? @map("run_id")
  runtimeEventId String? @map("runtime_event_id")
  partKey        String  @map("part_key")
  partIndex      Int     @map("part_index")
  entityType     String? @map("entity_type")
  entityId       String? @map("entity_id")
  type           String  @map("type")
  state          String  @default("streaming") @map("state")
  text           String? @map("text")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, partKey], map: "uq_message_parts_message_part_key")
  @@unique([messageId, partIndex], map: "uq_message_parts_message_part_index")
  @@index([messageId, partIndex], map: "idx_message_parts_message_id_part_index")
  @@index([conversationId], map: "idx_message_parts_conversation_id")
  @@index([runId], map: "idx_message_parts_run_id")
  @@index([messageId, firstEventSequence], map: "idx_message_parts_message_first_event_sequence")
  @@index([type], map: "idx_message_parts_type")
  @@map("message_parts")
}

model MessagePin {
  id             String @id @map("id")
  conversationId String @map("conversation_id")
  messageId      String @map("message_id")
  note           String? @map("note")
  sortOrder      Int    @default(0) @map("sort_order")
  createdAt      String @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId], map: "uq_message_pins_conv_message")
  @@index([conversationId], map: "idx_message_pins_conversation_id")
  @@map("message_pins")
}

model Run {
  id                   String  @id @map("id")
  conversationId       String  @map("conversation_id")
  triggerMessageId     String  @map("trigger_message_id")
  mode                 String  @map("mode")
  status               String  @default("queued") @map("status")
  runtimeId            String? @map("runtime_id")
  orchestratorAgentId  String? @map("orchestrator_agent_id")
  inputJson            String  @default("{}") @map("input_json")
  planJson             String? @map("plan_json")
  errorJson            String? @map("error_json")
  lastEventSequence    Int     @default(0) @map("last_event_sequence")
  lastProjectedSequence Int     @default(0) @map("last_projected_sequence")
  startedAt            String? @map("started_at")
  completedAt          String? @map("completed_at")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage  Message           @relation("RunTriggerMessage", fields: [triggerMessageId], references: [id])
  events          RunEvent[]
  messages        Message[]         @relation("RunMessages")
  artifacts       Artifact[]
  permissions     PermissionRequest[]
  toolCalls       RunToolCall[]
  reasoningBlocks RunReasoningBlock[]
  taskGroups      RunTaskGroup[]
  tasks           RunTask[]
  plans           RunPlan[]

  @@index([conversationId, createdAt], map: "idx_runs_conversation_id_created_at")
  @@index([triggerMessageId], map: "idx_runs_trigger_message_id")
  @@index([status], map: "idx_runs_status")
  @@index([runtimeId], map: "idx_runs_runtime_id")
  @@map("runs")
}

model RunEvent {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  runtimeRunId   String? @map("runtime_run_id")
  conversationId String  @map("conversation_id")
  agentId        String? @map("agent_id")
  parentAgentId  String? @map("parent_agent_id")
  parentTaskId   String? @map("parent_task_id")
  taskId         String? @map("task_id")
  groupId        String? @map("group_id")
  toolCallId     String? @map("tool_call_id")
  toolName       String? @map("tool_name")
  messageId      String? @map("message_id")
  messageIndex   Int?    @map("message_index")
  type           String  @map("type")
  sequence       Int     @map("sequence")
  occurredAt     String? @map("occurred_at")
  payloadJson    String  @default("{}") @map("payload_json")
  createdAt      String  @map("created_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "uq_run_events_run_sequence")
  @@index([runId, sequence], map: "idx_run_events_run_id_sequence")
  @@index([runtimeRunId], map: "idx_run_events_runtime_run_id")
  @@index([conversationId], map: "idx_run_events_conversation_id")
  @@index([agentId], map: "idx_run_events_agent_id")
  @@index([messageId], map: "idx_run_events_message_id")
  @@index([taskId], map: "idx_run_events_task_id")
  @@index([groupId], map: "idx_run_events_group_id")
  @@index([toolCallId], map: "idx_run_events_tool_call_id")
  @@index([type], map: "idx_run_events_type")
  @@map("run_events")
}

model RunToolCall {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  conversationId String  @map("conversation_id")
  toolCallId     String  @map("tool_call_id")
  agentId        String? @map("agent_id")
  parentAgentId  String? @map("parent_agent_id")
  parentTaskId   String? @map("parent_task_id")
  taskId         String? @map("task_id")
  groupId        String? @map("group_id")
  messageId      String? @map("message_id")
  messageIndex   Int?    @map("message_index")
  toolName       String  @map("tool_name")
  displayPolicy  String  @default("timeline") @map("display_policy")
  state          String  @default("input-available") @map("state")
  riskLevel      String? @map("risk_level")
  summary        String? @map("summary")
  inputJson      String? @map("input_json")
  outputJson     String? @map("output_json")
  errorJson      String? @map("error_json")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  startedAt      String? @map("started_at")
  completedAt    String? @map("completed_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId], map: "uq_run_tool_calls_run_tool_call")
  @@index([conversationId], map: "idx_run_tool_calls_conversation_id")
  @@index([runId, firstEventSequence], map: "idx_run_tool_calls_run_first_event_sequence")
  @@index([toolCallId], map: "idx_run_tool_calls_tool_call_id")
  @@index([toolName], map: "idx_run_tool_calls_tool_name")
  @@map("run_tool_calls")
}

model RunReasoningBlock {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  conversationId String  @map("conversation_id")
  reasoningId    String  @map("reasoning_id")
  agentId        String? @map("agent_id")
  parentAgentId  String? @map("parent_agent_id")
  parentTaskId   String? @map("parent_task_id")
  taskId         String? @map("task_id")
  groupId        String? @map("group_id")
  messageId      String? @map("message_id")
  messageIndex   Int?    @map("message_index")
  content        String  @default("") @map("content")
  state          String  @default("streaming") @map("state")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  startedAt      String? @map("started_at")
  completedAt    String? @map("completed_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, reasoningId], map: "uq_run_reasoning_blocks_run_reasoning")
  @@index([conversationId], map: "idx_run_reasoning_blocks_conversation_id")
  @@index([runId, firstEventSequence], map: "idx_run_reasoning_blocks_run_first_event_sequence")
  @@index([reasoningId], map: "idx_run_reasoning_blocks_reasoning_id")
  @@map("run_reasoning_blocks")
}

model RunTaskGroup {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  conversationId String  @map("conversation_id")
  groupId        String  @map("group_id")
  agentId        String? @map("agent_id")
  parentAgentId  String? @map("parent_agent_id")
  parentTaskId   String? @map("parent_task_id")
  title          String? @map("title")
  state          String  @default("running") @map("state")
  summary        String? @map("summary")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  startedAt      String? @map("started_at")
  completedAt    String? @map("completed_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  tasks RunTask[]

  @@unique([runId, groupId], map: "uq_run_task_groups_run_group")
  @@unique([groupId], map: "uq_run_task_groups_group_id_unique")
  @@index([conversationId], map: "idx_run_task_groups_conversation_id")
  @@index([runId, firstEventSequence], map: "idx_run_task_groups_run_first_event_sequence")
  @@index([groupId], map: "idx_run_task_groups_group_id")
  @@map("run_task_groups")
}

model RunTask {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  conversationId String  @map("conversation_id")
  taskId         String  @map("task_id")
  groupId        String? @map("group_id")
  agentId        String? @map("agent_id")
  parentAgentId  String? @map("parent_agent_id")
  parentTaskId   String? @map("parent_task_id")
  targetAgentId  String? @map("target_agent_id")
  title          String? @map("title")
  instruction    String? @map("instruction")
  expectedOutput String? @map("expected_output")
  summary        String? @map("summary")
  state          String  @default("pending") @map("state")
  dependsOnJson  String  @default("[]") @map("depends_on_json")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  startedAt      String? @map("started_at")
  completedAt    String? @map("completed_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskGroup RunTaskGroup? @relation(fields: [groupId], references: [groupId])

  @@unique([runId, taskId], map: "uq_run_tasks_run_task")
  @@index([conversationId], map: "idx_run_tasks_conversation_id")
  @@index([runId, firstEventSequence], map: "idx_run_tasks_run_first_event_sequence")
  @@index([groupId], map: "idx_run_tasks_group_id")
  @@index([taskId], map: "idx_run_tasks_task_id")
  @@map("run_tasks")
}

model RunPlan {
  id             String  @id @map("id")
  runId          String  @map("run_id")
  conversationId String  @map("conversation_id")
  sourceEventId  String? @map("source_event_id")
  revision       Int     @default(0) @map("revision")
  entryAgentId   String? @map("entry_agent_id")
  intent         String? @map("intent")
  summaryInstruction String? @map("summary_instruction")
  state          String  @default("completed") @map("state")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  completedAt    String? @map("completed_at")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  tasks RunPlanTask[]

  @@index([conversationId], map: "idx_run_plans_conversation_id")
  @@index([runId, firstEventSequence], map: "idx_run_plans_run_first_event_sequence")
  @@index([runId, revision], map: "idx_run_plans_run_revision")
  @@unique([runId, sourceEventId], map: "uq_run_plans_run_source_event")
  @@map("run_plans")
}

model RunPlanTask {
  id             String  @id @map("id")
  planId         String  @map("plan_id")
  conversationId String  @map("conversation_id")
  taskId         String  @map("task_id")
  targetAgentId  String? @map("target_agent_id")
  title          String? @map("title")
  instruction    String? @map("instruction")
  expectedOutput String? @map("expected_output")
  state          String  @default("pending") @map("state")
  riskLevel      String? @map("risk_level")
  dependsOnJson  String  @default("[]") @map("depends_on_json")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  sortOrder      Int     @default(0) @map("sort_order")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  plan RunPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId], map: "uq_run_plan_tasks_plan_task")
  @@index([conversationId], map: "idx_run_plan_tasks_conversation_id")
  @@index([planId, sortOrder], map: "idx_run_plan_tasks_plan_sort_order")
  @@index([planId, firstEventSequence], map: "idx_run_plan_tasks_plan_first_event_sequence")
  @@map("run_plan_tasks")
}

model Artifact {
  id               String  @id @map("id")
  conversationId   String  @map("conversation_id")
  runId            String? @map("run_id")
  messageId        String? @map("message_id")
  createdByAgentId String? @map("created_by_agent_id")
  type             String  @map("type")
  title            String  @map("title")
  status           String  @default("draft") @map("status")
  currentVersionId String? @map("current_version_id")
  metadataJson     String  @default("{}") @map("metadata_json")
  createdAt        String  @map("created_at")
  updatedAt        String  @map("updated_at")

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run         Run?             @relation(fields: [runId], references: [id])
  versions    ArtifactVersion[]

  @@index([conversationId], map: "idx_artifacts_conversation_id")
  @@index([runId], map: "idx_artifacts_run_id")
  @@index([createdByAgentId], map: "idx_artifacts_created_by_agent_id")
  @@index([type, status], map: "idx_artifacts_type_status")
  @@map("artifacts")
}

model ArtifactVersion {
  id               String  @id @map("id")
  artifactId       String  @map("artifact_id")
  version          Int     @map("version")
  source           String  @map("source")
  language         String? @map("language")
  content          String  @map("content")
  summary          String? @map("summary")
  diffJson         String? @map("diff_json")
  createdByAgentId String? @map("created_by_agent_id")
  createdAt        String  @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version], map: "uq_artifact_versions_artifact_version")
  @@index([artifactId, version], map: "idx_artifact_versions_artifact_id_version")
  @@map("artifact_versions")
}

model PermissionRequest {
  id             String  @id @map("id")
  conversationId String  @map("conversation_id")
  runId          String  @map("run_id")
  agentId        String  @map("agent_id")
  runtimeRequestId String? @map("runtime_request_id")
  messageId      String? @map("message_id")
  messageIndex   Int?    @map("message_index")
  parentAgentId  String? @map("parent_agent_id")
  taskId         String? @map("task_id")
  groupId        String? @map("group_id")
  parentTaskId   String? @map("parent_task_id")
  toolCallId     String? @map("tool_call_id")
  toolName       String? @map("tool_name")
  riskLevel      String? @map("risk_level")
  permissionType String  @map("permission_type")
  target         String  @map("target")
  description    String  @map("description")
  status         String  @default("pending") @map("status")
  resolvedAt    String? @map("resolved_at")
  expiresAt     String? @map("expires_at")
  reason         String? @map("reason")
  decisionReason String? @map("decision_reason")
  grantJson      String? @map("grant_json")
  dataJson       String? @map("data_json")
  payloadJson    String  @default("{}") @map("payload_json")
  firstEventSequence Int? @map("first_event_sequence")
  lastEventSequence  Int? @map("last_event_sequence")
  metadataJson   String  @default("{}") @map("metadata_json")
  createdAt      String  @map("created_at")
  updatedAt      String  @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          Run          @relation(fields: [runId], references: [id])

  @@index([conversationId], map: "idx_permission_requests_conversation_id")
  @@index([runId], map: "idx_permission_requests_run_id")
  @@index([status], map: "idx_permission_requests_status")
  @@index([agentId], map: "idx_permission_requests_agent_id")
  @@index([runtimeRequestId], map: "idx_permission_requests_runtime_request_id")
  @@index([toolCallId], map: "idx_permission_requests_tool_call_id")
  @@index([firstEventSequence], map: "idx_permission_requests_first_event_sequence")
  @@map("permission_requests")
}
